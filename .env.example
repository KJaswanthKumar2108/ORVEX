# ==============================================================================
# ORVEX Platform Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your target deployment.
# ==============================================================================

# Application Environment ('development' | 'production' | 'testing')
ENVIRONMENT=development

# PostgreSQL / TimescaleDB Configuration
POSTGRES_DB=orvex
POSTGRES_USER=orvex
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg://orvex:replace-with-a-local-secret@localhost:5433/orvex

# MQTT Hardware Broker Configuration
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=orvex-core-gateway
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=orvex
MQTT_KEEPALIVE=60
MQTT_RECONNECT_INTERVAL_SECONDS=5.0
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=

# HTTP & Security Controls
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Production Worker Concurrency
WEB_CONCURRENCY=2
